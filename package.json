{
  "name": "baseball-data-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "collector:import": "tsx scripts/collect-standings.ts",
    "collector:daily": "tsx scripts/collect-standings.ts --daily",
    "collector:npb": "tsx scripts/collect-npb.ts",
    "collector:npb:daily": "tsx scripts/collect-npb.ts --fetch",
    "collector:npb:game": "tsx scripts/collect-npb-game.ts",
    "backup:npb:drill": "tsx scripts/backup-npb.ts",
    "backup:npb:restore": "tsx scripts/restore-npb-backup.ts",
    "collector:npb:day:dry-run": "tsx scripts/dry-run-npb-day.ts",
    "collector:npb:day": "tsx scripts/collect-npb-day.ts",
    "verify:npb:day": "tsx scripts/verify-npb-day.ts",
    "verify:npb:remote": "tsx scripts/verify-npb-database.ts",
    "publish:npb:remote": "tsx scripts/publish-npb-payload.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/preferences": "^8.0.1",
    "@libsql/client": "^0.18.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
